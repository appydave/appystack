{
  "path": ["client", "server", "shared", "scripts", "lint", "e2e"],
  "format": ["typescript", "tsx", "javascript", "jsx"],
  "minLines": 10,
  "minTokens": 100,
  "threshold": 0,
  "reporters": ["console"],
  "pattern": "**/{*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs,mts,cts},test/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}}",
  "ignore": ["**/node_modules/**", "**/dist/**", "**/coverage/**"]
}
